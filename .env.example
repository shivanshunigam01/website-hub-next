# =============================================================================
# TeacherPoint Frontend (Next.js) — environment template
# Copy to .env.local (and .env.development.local for local dev). Never commit secrets.
# =============================================================================

# ── API ───────────────────────────────────────────────────────────────────────
# Public API origin (asset URLs) — no /api/v1 suffix:
# NEXT_PUBLIC_API_ORIGIN=https://api.teacherpoint.org
# Local dev (backend on port 4000):
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_DEBUG=true

# Production:
# NEXT_PUBLIC_API_URL=https://api.teacherpoint.org/api/v1
# NEXT_PUBLIC_API_BASE_URL=https://api.teacherpoint.org/api/v1
# NEXT_PUBLIC_API_DEBUG=false

# ── Google OAuth (must match backend GOOGLE_CLIENT_ID exactly) ───────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Razorpay Standard Checkout (public KEY_ID only — never KEY_SECRET) ────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Geoapify (SSR geo in dev; prod uses backend GET /api/v1/geo/ip) ───────────
GEOAPIFY_API_KEY=
NEXT_PUBLIC_GEOAPIFY_API_KEY=
