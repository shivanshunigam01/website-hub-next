# =============================================================================
# TeacherPoint Frontend (Next.js) — shared defaults
# Restart `npm run dev` after changing any NEXT_PUBLIC_* variable
# =============================================================================

# ── API (production) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_ORIGIN=https://api.teacherpoint.org
NEXT_PUBLIC_API_URL=https://api.teacherpoint.org/api/v1
NEXT_PUBLIC_API_BASE_URL=https://api.teacherpoint.org/api/v1
NEXT_PUBLIC_API_DEBUG=false

# Local backend (uncomment for local dev):
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
# NEXT_PUBLIC_API_DEBUG=true

# ── Google OAuth (must match backend GOOGLE_CLIENT_ID exactly) ───────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=127339398195-5gghcqf84esnl3gj8ld6r90qu5dcl0a0.apps.googleusercontent.com

# ── Razorpay Standard Checkout (public KEY_ID only — must match backend RAZORPAY_KEY_ID) ────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_TIrXvkLaS9Zi3P

# ── Geoapify (SSR geo routes in dev; production uses backend /api/v1/geo/ip) ──
GEOAPIFY_API_KEY=cbc081690c794522ae9c98fadf7333ae
NEXT_PUBLIC_GEOAPIFY_API_KEY=cbc081690c794522ae9c98fadf7333ae
